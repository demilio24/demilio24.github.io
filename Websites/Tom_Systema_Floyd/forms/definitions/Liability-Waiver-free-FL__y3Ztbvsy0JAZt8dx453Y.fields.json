    "html": "<!-- SF Date & Time — split layout, no conflict -->\n<div id=\"sf-dt-wrap\" style=\"font-family:Arial,sans-serif;font-size:14px;color:#333;display:flex;justify-content:space-between;align-items:center;padding:8px 0;width:100%\">\n  <span>Date: <strong id=\"sf-dt-date\" style=\"color:#000\"></strong></span>\n  <span>Time: <strong id=\"sf-dt-time\" style=\"color:#000\"></strong></span>\n</div>\n<script>\n(function(){\n  function sfDT(){\n    var n = new Date();\n    var d = n.toLocaleDateString('en-US',{month:'numeric',day:'numeric',year:'numeric'});\n    var t = n.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:true});\n    var de = document.getElementById('sf-dt-date');\n    var te = document.getElementById('sf-dt-time');\n    if(de) de.textContent = d;\n    if(te) te.textContent = t;\n  }\n  sfDT();\n  setInterval(sfDT,1000);\n})();\n</script>",
